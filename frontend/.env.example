# ── Database (Turso / libSQL) ──────────────────────────────────────────
TURSO_URL=libsql://your-db.turso.io
TURSO_TOKEN=your-turso-token

# ── Insforge (auth + storage) ──────────────────────────────────────────
INF_BASE_URL=https://your-project.insforge.app
INF_API_KEY=your-insforge-service-key

# ── Admin auth ─────────────────────────────────────────────────────────
# Fallback bearer token for the admin panel (also signs Google sessions).
ADMIN_TOKEN=change-me

# Optional: dedicated secret for signing Google admin sessions.
# If unset, ADMIN_TOKEN is used.
ADMIN_SESSION_SECRET=

# ── Google Sign-In (admin login) ───────────────────────────────────────
# Create an OAuth client at https://console.cloud.google.com/apis/credentials
# (type: Web application). Add your deployed URL to its authorized origins.
# Put the SAME client id in both vars.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_ID=

# ── Optional: canonical site URL for sitemap/robots ────────────────────
NEXT_PUBLIC_SITE_URL=
