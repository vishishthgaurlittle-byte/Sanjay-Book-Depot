# Sanjay Book Depot - backend credentials (gitignored, never commit)
#
# Turso      = database (SQLite/libSQL)
# Insforge   = authentication + file storage (images, 3D models)
#
# Both are privileged credentials. Use them ONLY from server-side code
# (Node scripts, Next.js route handlers). Never expose them to the browser.

TURSO_URL=libsql://sanjay-axuile.aws-ap-south-1.turso.io
TURSO_TOKEN=replace_me

INF_BASE_URL=https://x2m4egk3.ap-southeast.insforge.app
INF_API_KEY=replace_me

# Admin panel fallback auth. Insforge login is currently blocked by
# requireEmailVerification with no SMTP, so the admin API also accepts this
# shared secret as a bearer token. Delete this line to disable that path.
ADMIN_TOKEN=
